# Console over USB Serial/JTAG (separate clock domain from USB-OTG, so we
# get boot logs before TinyUSB takes the OTG peripheral).
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_COUNT=1
CONFIG_TINYUSB_HID_COUNT=1

CONFIG_FREERTOS_HZ=1000

# Watchdog: keep enabled so we panic+reboot on hang instead of hanging forever.
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_PANIC=y
